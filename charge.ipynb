   "source": [
    "##某一景点收费标准：6岁以下儿童免票；6~18岁收费50元人民币；18~65岁收费75元人民币；65岁以上人群收费25元。\n",
    "age = int(input(\"请输入您的年龄：\"))\n",
    "\n",
    "if age < 6:\n",
    "    price = 0\n",
    "elif age < 18:\n",
    "    price = 50\n",
    "elif age < 65:\n",
    "    price = 75\n",
    "elif age >= 65:\n",
    "    price = 25\n",
    "\n",
    "print(\"您的票价为：\",price,\"元人民币\")"
   ]
